<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<RootNamespace>$(RootName)</RootNamespace>
	<AssemblyName>$(OrgName).EntityFrameworkCore</AssemblyName>
	<Title>$(OrgName).EntityFrameworkCore</Title>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<Authors>minhvu</Authors>
	<Description>EF Core plugin package containing EF Core evaluator.</Description>
	<Summary>EF Core plugin package containing EF Core evaluator.</Summary>
	<Version>$(NugetVersion)</Version>
	<PackageTags>lightframework;dotnet;aspnetcore</PackageTags>
	<PackageIcon>icon.png</PackageIcon>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Dapper" Version="2.1.79" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(AspnetVersion)" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Specification\Specification.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Using Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

</Project>
