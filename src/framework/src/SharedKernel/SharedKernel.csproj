<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<RootNamespace>$(RootName)</RootNamespace>
	<AssemblyName>$(OrgName).SharedKernel</AssemblyName>
	<Title>$(OrgName).SharedKernel</Title>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<Authors>minhvu</Authors>
	<Description>Package containing useful base interfaces, classes, enums, value objects.</Description>
	<Summary>Package containing useful base interfaces, classes, enums, value objects.</Summary>
	<Version>$(NugetVersion)</Version>
	<PackageTags>lightframework;dotnet;aspnetcore</PackageTags>
	<PackageIcon>icon.png</PackageIcon>
	<PackageReleaseNotes></PackageReleaseNotes>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

</Project>
